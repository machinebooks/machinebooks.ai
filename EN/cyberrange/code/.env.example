# Companion code for "The Cyber Range and the Machine"
# Copy this file to .env and replace placeholders with real values.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://cyberadmin:password@localhost:3306/cyberrange

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=<YOUR_SECRET>
JWT_EXP_HOURS=4

# ── Proxmox VE ────────────────────────────────────────────
PROXMOX_HOST=<YOUR_PROXMOX_HOST>
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=<YOUR_TOKEN_ID>
PROXMOX_TOKEN_SECRET=<YOUR_TOKEN_SECRET>
PROXMOX_VERIFY_SSL=false

# ── Claude / Anthropic ────────────────────────────────────
ANTHROPIC_API_KEY=<YOUR_API_KEY>
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Flag Generation ───────────────────────────────────────
FLAG_HMAC_SECRET=<YOUR_FLAG_SECRET>
FLAG_PREFIX=CYBERRANGE

# ── Ansible ───────────────────────────────────────────────
ANSIBLE_PLAYBOOKS_DIR=/app/playbooks
ANSIBLE_INVENTORY_DIR=/app/inventory

# ── Network Isolation ─────────────────────────────────────
VLAN_RANGE_START=100
VLAN_RANGE_END=999
MANAGEMENT_NETWORK=10.0.0.0/24
