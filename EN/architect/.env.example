# =============================================================================
# The Architect and the Machine — Environment Variables
# Chapter 20: Docker Compose configuration
# =============================================================================

# --- Database (Chapter 5) ---------------------------------------------------
DB_USER=plataforma
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_HOST=db
MYSQL_ROOT_PASSWORD=<YOUR_ROOT_PASSWORD>
MYSQL_OPS_USER=ops_user
MYSQL_OPS_PASSWORD=<YOUR_OPS_PASSWORD>

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- AI Service (Chapter 11) ------------------------------------------------
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AZURE_OPENAI_API_KEY=<YOUR_AZURE_API_KEY>
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AI_SERVICE_API_KEY=<YOUR_INTERNAL_API_KEY>

# --- Qdrant (Chapter 12) ----------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Meilisearch (Chapter 13) -----------------------------------------------
MEILI_MASTER_KEY=<YOUR_MEILI_KEY>

# --- JWT (Chapter 6) --------------------------------------------------------
JWT_SECRET_KEY=<YOUR_JWT_SECRET>
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=28800

# --- Celery (Chapter 8) -----------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
